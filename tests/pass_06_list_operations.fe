// Tests List operations: constructor, push, pop, len, contains, remove, reverse, slice, insert, clear, index access/assignment
fun main() {
    // Empty list constructor
    keep l: List<int> = List();
    assert(l.len() == 0, "empty list len");
    // push and len
    l.push(10);
    l.push(20);
    l.push(30);
    assert(l.len() == 3, "len after push");
    // index access
    assert(l[0] == 10, "index 0");
    assert(l[1] == 20, "index 1");
    assert(l[2] == 30, "index 2");
    // contains
    assert(l.contains(20), "contains 20");
    // pop
    keep popped: int = l.pop();
    assert(popped == 30, "pop returns last");
    assert(l.len() == 2, "len after pop");
    // insert at index
    l.insert(1, 15);
    assert(l[0] == 10, "insert keeps head");
    assert(l[1] == 15, "insert at 1");
    assert(l[2] == 20, "insert shifts tail");
    assert(l.len() == 3, "len after insert");
    // remove at index
    l.remove(1);
    assert(l[0] == 10, "remove keeps head");
    assert(l[1] == 20, "remove shifts");
    assert(l.len() == 2, "len after remove");
    // reverse
    l.reverse();
    assert(l[0] == 20, "reverse first");
    assert(l[1] == 10, "reverse second");
    // slice
    l.push(30);
    l.push(40);
    keep sub: List<int> = l.slice(1, 3);
    assert(sub.len() == 2, "slice len");
    assert(sub[0] == 10, "slice[0]");
    assert(sub[1] == 30, "slice[1]");
    // clear
    l.clear();
    assert(l.len() == 0, "len after clear");
    // List with initial push sequence
    keep nums: List<int> = List();
    keep i: int = 0;
    while i < 5 {
        nums.push(i * i);
        i = i + 1;
    };
    assert(nums.len() == 5, "loop push len");
    assert(nums[0] == 0, "0*0");
    assert(nums[4] == 16, "4*4");
    print("pass_06_list_operations ok");
}
