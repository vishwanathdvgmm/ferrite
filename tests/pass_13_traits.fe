// Test: Trait declarations, trait implementation, and operator overloading
trait Add {
    fun add(self, other: Self) -> Self;
}

trait Display {
    fun to_string(self) -> string;
}

group Vec2 {
    x: float;
    y: float;
}

impl Add for Vec2 {
    fun add(self, other: Vec2) -> Vec2 {
        return Vec2 { x: self.x + other.x, y: self.y + other.y };
    }
}

impl Display for Vec2 {
    fun to_string(self) -> string {
        return "Vec2";
    }
}

// Test operator overloading: + uses Add trait (for LLVM backend, interpreter uses method call)
fun test_add() {
    keep a: Vec2 = Vec2 { x: 1.0, y: 2.0 };
    keep b: Vec2 = Vec2 { x: 3.0, y: 4.0 };
    keep c: Vec2 = add(a, b);
}

fun main() {
    test_add();
}
