// ── PASS TEST 19: Match with Enum Destructuring, Stop, Skip ──
// Expected: ferrite run → prints output below
enum Shape {
    Circle(int);
    Rect(int, int);
    Unknown;
}

fun describe_shape(s: Shape) -> string {
    match s {
        case Circle(r) => {
            return "circle r=" + str(r);
        }
        case Rect(w, h) => {
            return "rect " + str(w) + "x" + str(h);
        }
        case Unknown => {
            return "unknown";
        }
    }
}

fun main() {
    // Test match with enum destructuring
    keep c: Shape = Circle(5);
    println(describe_shape(c));
    keep r: Shape = Rect(3, 7);
    println(describe_shape(r));
    keep u: Shape = Unknown;
    println(describe_shape(u));
    // Test while with stop and skip
    keep i: int = 0;
    while i < 10 {
        i = i + 1;
        if i == 3 {
            skip;
        }
        if i == 7 {
            stop;
        }
        println(str(i));
    }
}
