// FAIL: Trait bound violated — calling function with type that doesn't implement required trait
// Expected error: "does not implement trait"
trait Sortable {
    fun compare(self, other: Self) -> int;
}

group Apple {
    weight: float;
}

// Apple does NOT implement Sortable
// This function tries to use + on Apple, which requires Add trait
fun try_add(a: Apple, b: Apple) -> Apple {
    return a + b;
}

fun main() {
    keep a: Apple = Apple { weight: 1.0 };
    keep b: Apple = Apple { weight: 2.0 };
    keep c: Apple = try_add(a, b);
}
