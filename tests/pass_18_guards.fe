// ── PASS TEST 18: Guard Clauses in Match ──
// Expected: ferrite run → prints correct guard results

fun classify(x: int) -> string {
    match x {
        case n if n < 0 => {
            return "negative";
        }
        case 0 => {
            return "zero";
        }
        case n if n > 100 => {
            return "large";
        }
        default => {
            return "positive";
        }
    }
}

fun main() {
    println(classify(-5));
    println(classify(0));
    println(classify(42));
    println(classify(200));
}
