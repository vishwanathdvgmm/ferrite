// Test: Field access on groups returns correct types (not Type::Error)

group Point {
    x: float;
    y: float;
}

group Person {
    name: string;
    age: int;
}

fun test_field_access() {
    keep p: Point = Point { x: 1.0, y: 2.0 };
    keep px: float = p.x;
    keep py: float = p.y;
    
    keep person: Person = Person { name: "Alice", age: 30 };
    keep n: string = person.name;
    keep a: int = person.age;
    
    // Use the fields in expressions
    keep sum: float = p.x + p.y;
    keep is_adult: bool = person.age > 18;
}

fun main() {
    test_field_access();
}
