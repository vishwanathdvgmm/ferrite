// ── PASS TEST 06: Top-level constants ──
// Expected: ferrite check → ✅
keep PI: float = 3.14159;

keep MAX_SIZE: int = 1024;

keep GREETING: string = "Hello Ferrite";

keep DEBUG: bool = false;

fun use_constants() -> float {
    keep radius: float = 5.0;
    keep area: float = PI * radius * radius;
    return area;
}
