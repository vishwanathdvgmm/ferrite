// Ferrite Benchmark: Ackermann Function
fun ackermann(m: int, n: int) -> int {
    if m == 0 {
        return n + 1;
    }
    if n == 0 {
        return ackermann(m - 1, 1);
    }
    return ackermann(m - 1, ackermann(m, n - 1));
}

fun main() {
    keep res: int = ackermann(3, 8);
    println("Ackermann(3, 8) = " + str(res));
}
